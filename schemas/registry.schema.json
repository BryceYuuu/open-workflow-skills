{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Workflow Skills Registry",
  "type": "object",
  "required": [
    "name",
    "version",
    "summary",
    "skills"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "production",
        "integration",
        "experimental"
      ],
      "properties": {
        "total": {
          "const": 100
        },
        "production": {
          "type": "integer",
          "minimum": 0
        },
        "integration": {
          "type": "integer",
          "minimum": 0
        },
        "experimental": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "name_zh",
          "category",
          "status",
          "quality_score",
          "automation_level",
          "description",
          "description_zh",
          "skill_path"
        ]
      }
    }
  }
}
